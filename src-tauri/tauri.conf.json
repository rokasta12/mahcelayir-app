{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mahmut Celayir",
  "version": "0.1.0",
  "identifier": "com.mahmutcelayir.archive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mahmut Celayir",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["fonts/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFMDNDOUQ3QTQ1QTc5NjkKUldScGVWcWsxOGtEWHR3NDJySm16M0E1dTEwOGRWVjVFR0tjM1RSSUVWSDVmMjRKS3B0a2pNdmcK",
      "endpoints": [
        "https://github.com/rokasta12/mahcelayir-app/releases/latest/download/latest.json"
      ]
    }
  }
}
